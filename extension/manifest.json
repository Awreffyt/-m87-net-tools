{
  "manifest_version": 3,
  "name": "M87 端点直连",
  "version": "1.0.0",
  "description": "让 M87 网页版直接读取任意页面（含 Cookie/JS 门禁站）的最终内容。一次安装，之后全自动。",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {}
}